class CurriculumExplorerScreen extends StatelessWidget {
  final bool isUniversity;
  final String selectedUniversity;
  final String selectedCollege;
  final String selectedMajor;
  final String selectedGeneralStage;
  final String selectedCourse;
  final Function({bool? isUni, String? uni, String? college, String? major, String? stage, String? course}) onUpdate;
  final VoidCallback onStartStudying;

  const CurriculumExplorerScreen({
    super.key,
    required this.isUniversity,
    required this.selectedUniversity,
    required this.selectedCollege,
    required this.selectedMajor,
    required this.selectedGeneralStage,
    required this.selectedCourse,
    required this.onUpdate,
    required this.onStartStudying,
  });

  @override
  Widget build(BuildContext context) {
    final List<String> courses = isUniversity
        ? (SaudiCurriculumData.collegeMajors[selectedCollege]?[selectedMajor] ?? [])
        : (SaudiCurriculumData.generalEducation[selectedGeneralStage] ?? []);

    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        // مفتاح التبديل بين التعليم الجامعي والتعليم العام
        SegmentedButton<bool>(
          segments: const [
            ButtonSegment(value: true, label: Text('التعليم الجامعي'), icon: Icon(Icons.account_balance)),
            ButtonSegment(value: false, label: Text('التعليم العام وقياس'), icon: Icon(Icons.menu_book)),
          ],
          selected: {isUniversity},
          onSelectionChanged: (set) {
            final uniMode = set.first;
            if (uniMode) {
              onUpdate(
                isUni: true,
                college: 'كلية التربية',
                major: 'علوم الرياضة والنشاط البدني',
                course: 'مبادئ علم الحركة',
              );
            } else {
              onUpdate(
                isUni: false,
                stage: 'المرحلة الثانوية (نظام المسارات)',
                course: 'الرياضيات (1 - 3)',
              );
            }
          },
        ),
        const SizedBox(height: 16),

        if (isUniversity) ...[
          _buildDropdownCard(
            title: 'الجامعة السعودية',
            icon: Icons.location_city,
            value: selectedUniversity,
            items: SaudiCurriculumData.universities,
            onChanged: (val) => onUpdate(uni: val),
          ),
          const SizedBox(height: 12),
          _buildDropdownCard(
            title: 'الكلية',
            icon: Icons.domain,
            value: selectedCollege,
            items: SaudiCurriculumData.collegeMajors.keys.toList(),
            onChanged: (val) {
              final firstMajor = SaudiCurriculumData.collegeMajors[val]!.keys.first;
              final firstCourse = SaudiCurriculumData.collegeMajors[val]![firstMajor]!.first;
              onUpdate(college: val, major: firstMajor, course: firstCourse);
            },
          ),
          const SizedBox(height: 12),
          _buildDropdownCard(
            title: 'التخصص الأكاديمي',
            icon: Icons.workspace_premium,
            value: selectedMajor,
            items: SaudiCurriculumData.collegeMajors[selectedCollege]!.keys.toList(),
            onChanged: (val) {
              final firstCourse = SaudiCurriculumData.collegeMajors[selectedCollege]![val]!.first;
              onUpdate(major: val, course: firstCourse);
            },
          ),
        ] else ...[
          _buildDropdownCard(
            title: 'المرحلة الدراسية',
            icon: Icons.stairs,
            value: selectedGeneralStage,
            items: SaudiCurriculumData.generalEducation.keys.toList(),
            onChanged: (val) {
              final firstCourse = SaudiCurriculumData.generalEducation[val]!.first;
              onUpdate(stage: val, course: firstCourse);
            },
          ),
        ],

        const SizedBox(height: 20),
        const Text(
          'المقررات والمواد الدراسية المتاحة:',
          style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold),
        ),
        const SizedBox(height: 10),

        ...courses.map((course) {
          final isSelected = course == selectedCourse;
          return Card(
            elevation: isSelected ? 2 : 0,
            color: isSelected ? const Color(0xFFECFDF5) : Colors.white,
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(14),
              side: BorderSide(
                color: isSelected ? const Color(0xFF059669) : Colors.grey.shade200,
                width: isSelected ? 1.5 : 1,
              ),
            ),
            child: ListTile(
              leading: CircleAvatar(
                backgroundColor: isSelected ? const Color(0xFF059669) : Colors.grey.shade100,
                child: Icon(
                  Icons.book,
                  color: isSelected ? Colors.white : Colors.grey.shade700,
                  size: 20,
                ),
              ),
              title: Text(course, style: const TextStyle(fontWeight: FontWeight.w600)),
              subtitle: Text(isSelected ? 'المقرر النشط حالياً' : 'اضغط للاختيار وبدء المذاكرة'),
              trailing: ElevatedButton(
                style: ElevatedButton.styleFrom(
                  backgroundColor: const Color(0xFF059669),
                  foregroundColor: Colors.white,
                  shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
                ),
                onPressed: () {
                  onUpdate(course: course);
                  onStartStudying();
                },
                child: const Text('ادرس الآن'),
              ),
            ),
          );
        }),
      ],
    );
  }

  Widget _buildDropdownCard({
    required String title,
    required IconData icon,
    required String value,
    required List<String> items,
    required ValueChanged<String?> onChanged,
  }) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 6),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: Colors.grey.shade200),
      ),
      child: Row(
        children: [
          Icon(icon, color: const Color(0xFF059669)),
          const SizedBox(width: 12),
          Expanded(
            child: DropdownButtonHideUnderline(
              child: DropdownButton<String>(
                isExpanded: true,
                value: items.contains(value) ? value : items.first,
                items: items.map((e) => DropdownMenuItem(value: e, child: Text(e))).toList(),
                onChanged: onChanged,
              ),
            ),
          ),
        ],
      ),
    );
  }
}

