class FileExplainerScreen extends StatefulWidget {
  final String contextLabel;
  const FileExplainerScreen({super.key, required this.contextLabel});

  @override
  State<FileExplainerScreen> createState() => _FileExplainerScreenState();
}

class _FileExplainerScreenState extends State<FileExplainerScreen> {
  File? _selectedFile;
  String _fileName = '';
  String _analysisResult = '';
  bool _analyzing = false;

  Future<void> _chooseFile() async {
    final result = await FilePicker.platform.pickFiles(
      type: FileType.custom,
      allowedExtensions: ['pdf', 'doc', 'docx', 'pptx', 'txt', 'png', 'jpg', 'jpeg'],
    );
    if (result != null && result.files.single.path != null) {
      setState(() {
        _selectedFile = File(result.files.single.path!);
        _fileName = result.files.single.name;
        _analysisResult = '';
      });
    }
  }

  Future<void> _analyzeFile(String mode) async {
    setState(() => _analyzing = true);
    final res = await GeminiAIService.askMidad(
      prompt: 'المطلوب للملف المرفق ($_fileName): $mode',
      contextInfo: widget.contextLabel,
      attachedFile: _selectedFile,
    );
    setState(() {
      _analysisResult = res;
      _analyzing = false;
    });
  }

  @override
  Widget build(BuildContext context) {
    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        InkWell(
          onTap: _chooseFile,
          borderRadius: BorderRadius.circular(18),
          child: Container(
            padding: const EdgeInsets.all(24),
            decoration: BoxDecoration(
              color: Colors.white,
              borderRadius: BorderRadius.circular(18),
              border: Border.all(color: const Color(0xFF059669), width: 1.5),
            ),
            child: Column(
              children: [
                const Icon(Icons.cloud_upload_outlined, size: 48, color: Color(0xFF059669)),
                const SizedBox(height: 10),
                Text(
                  _fileName.isEmpty ? 'اضغط لرفع ملف المحاضرة أو الكتاب' : 'الملف المختار: $_fileName',
                  style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 15),
                  textAlign: TextAlign.center,
                ),
                const SizedBox(height: 4),
                const Text(
                  'يدعم: PDF, Word, PowerPoint, الصور والنصوص',
                  style: TextStyle(color: Colors.grey, fontSize: 12),
                ),
              ],
            ),
          ),
        ),
        const SizedBox(height: 16),

        if (_fileName.isNotEmpty) ...[
          Wrap(
            spacing: 8,
            runSpacing: 8,
            children: [
              ElevatedButton.icon(
                onPressed: _analyzing ? null : () => _analyzeFile('اشرح الملف شرحاً مبسطاً ومفصلاً خطوة بخطوة'),
                icon: const Icon(Icons.auto_stories, size: 18),
                label: const Text('شرح مبسط ومفصل'),
              ),
              ElevatedButton.icon(
                onPressed: _analyzing ? null : () => _analyzeFile('لخّص الملف في نقاط وجداول مقارنة للمراجعة النهائية'),
                icon: const Icon(Icons.table_chart, size: 18),
                label: const Text('تلخيص وجداول مقارنة'),
              ),
              ElevatedButton.icon(
                onPressed: _analyzing ? null : () => _analyzeFile('أنشئ 5 أسئلة اختبارية مع الإجابات من محتوى الملف'),
                icon: const Icon(Icons.quiz, size: 18),
                label: const Text('أسئلة مراجعة من الملف'),
              ),
            ],
          ),
          const SizedBox(height: 16),
        ],

        if (_analyzing) const Center(child: CircularProgressIndicator()),

        if (_analysisResult.isNotEmpty)
          Container(
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(
              color: Colors.white,
              borderRadius: BorderRadius.circular(16),
              border: Border.all(color: Colors.grey.shade200),
            ),
            child: SelectableText(_analysisResult, style: const TextStyle(height: 1.6)),
          ),
      ],
    );
  }
}

