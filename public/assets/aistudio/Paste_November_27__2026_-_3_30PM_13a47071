// ---------------------------------------------------------------------------
// 3. خدمة الاتصال بالذكاء الاصطناعي (Gemini API)
// ---------------------------------------------------------------------------
class GeminiAIService {
  // ضع مفتاح API الخاص بك من Google AI Studio هنا
  static const String apiKey = 'YOUR_GEMINI_API_KEY_HERE';

  static Future<String> askMidad({
    required String prompt,
    required String contextInfo,
    File? attachedFile,
  }) async {
    if (apiKey == 'YOUR_GEMINI_API_KEY_HERE' || apiKey.isEmpty) {
      await Future.delayed(const Duration(seconds: 1));
      return '✨ **استجابة مِداد AI التجريبية**\n\n'
          '📌 **السياق المختار:** $contextInfo\n\n'
          'بناءً على سؤالك حول: *"$prompt"*، إليك الشرح المنظم:\n'
          '1. **المفهوم الأساسي:** يرتكز هذا الموضوع في المنهج السعودي على فهم القواعد التطبيقية وربطها بالواقع العملي.\n'
          '2. **نقاط المراجعة السريعة:** ركّز على المصطلحات المفتاحية، التسلسل الفني والخطوات التطبيقية.\n'
          '3. **سؤال تدريبي:** ما هو العامل الأهم المؤثر في تحقيق الأداء الأمثل ضمن هذا المقرر؟\n\n'
          '💡 *ملاحظة: لتفعيل الذكاء الاصطناعي الحي، أضف مفتاح Gemini API في ملف `main.dart`.*';
    }

    try {
      final url = Uri.parse(
        'https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=$apiKey',
      );

      final List> parts = [
        {
          'text': 'أنت "مِداد AI"، مساعد دراسي ذكي متخصص في المناهج السعودية والجامعية. '
              'السياق الحالي للطالب: $contextInfo.\n'
              'أجب باللغة العربية بأسلوب واضح، منظم، ومشجع مع نقاط وتلخيص:\n\n$prompt'
        }
      ];

      if (attachedFile != null && await attachedFile.exists()) {
        final bytes = await attachedFile.readAsBytes();
        final base64Data = base64Encode(bytes);
        final ext = attachedFile.path.split('.').last.toLowerCase();
        String mimeType = 'application/pdf';
        if (ext == 'png') mimeType = 'image/png';
        if (ext == 'jpg' || ext == 'jpeg') mimeType = 'image/jpeg';

        if (['pdf', 'png', 'jpg', 'jpeg'].contains(ext)) {
          parts.add({
            'inline_data': {'mime_type': mimeType, 'data': base64Data}
          });
        }
      }

      final response = await http.post(
        url,
        headers: {'Content-Type': 'application/json'},
        body: jsonEncode({
          'contents': [
            {'parts': parts}
          ]
        }),
      );

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);
        return data['candidates'][0]['content']['parts'][0]['text'] ?? 'لم يتم استلام رد.';
      } else {
        return 'حدث خطأ في الاتصال بالخادم (${response.statusCode}).';
      }
    } catch (e) {
      return 'تعذر الاتصال بالإنترنت: $e';
    }
  }
}

