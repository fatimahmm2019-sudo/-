class StudyPlannerScreen extends StatefulWidget {
  const StudyPlannerScreen({super.key});

  @override
  State<StudyPlannerScreen> createState() => _StudyPlannerScreenState();
}

class _StudyPlannerScreenState extends State<StudyPlannerScreen> {
  int _secondsRemaining = 25 * 60;
  Timer? _timer;
  bool _isRunning = false;

  final List> _tasks = [
    {'title': 'مراجعة محاضرة مبادئ علم الحركة', 'done': false},
    {'title': 'تلخيص فصل الفنون التشكيلية والمجتمع', 'done': false},
  ];
  final TextEditingController _taskCtrl = TextEditingController();

  void _toggleTimer() {
    if (_isRunning) {
      _timer?.cancel();
      setState(() => _isRunning = false);
    } else {
      setState(() => _isRunning = true);
      _timer = Timer.periodic(const Duration(seconds: 1), (timer) {
        if (_secondsRemaining > 0) {
          setState(() => _secondsRemaining--);
        } else {
          timer.cancel();
          setState(() => _isRunning = false);
        }
      });
    }
  }

  void _resetTimer() {
    _timer?.cancel();
    setState(() {
      _isRunning = false;
      _secondsRemaining = 25 * 60;
    });
  }

  @override
  void dispose() {
    _timer?.cancel();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final minutes = (_secondsRemaining ~/ 60).toString().padLeft(2, '0');
    final seconds = (_secondsRemaining % 60).toString().padLeft(2, '0');

    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        // بطاقة مؤقت بومودورو
        Container(
          padding: const EdgeInsets.all(20),
          decoration: BoxDecoration(
            gradient: const LinearGradient(colors: [Color(0xFF059669), Color(0xFF4F46E5)]),
            borderRadius: BorderRadius.circular(20),
          ),
          child: Column(
            children: [
              const Text('مؤقت التركيز (بومودورو)', style: TextStyle(color: Colors.white70, fontSize: 14)),
              const SizedBox(height: 8),
              Text(
                '$minutes:$seconds',
                style: const TextStyle(color: Colors.white, fontSize: 48, fontWeight: FontWeight.bold),
              ),
              const SizedBox(height: 12),
              Row(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  ElevatedButton.icon(
                    onPressed: _toggleTimer,
                    icon: Icon(_isRunning ? Icons.pause : Icons.play_arrow),
                    label: Text(_isRunning ? 'إيقاف مؤقت' : 'ابدأ الجلسة'),
                  ),
                  const SizedBox(width: 12),
                  OutlinedButton(
                    style: OutlinedButton.styleFrom(foregroundColor: Colors.white, side: const BorderSide(color: Colors.white)),
                    onPressed: _resetTimer,
                    child: const Text('إعادة ضبط'),
                  ),
                ],
              ),
            ],
          ),
        ),

        const SizedBox(height: 20),
        const Text('قائمة مهام المذاكرة اليومية', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
        const SizedBox(height: 10),

        Row(
          children: [
            Expanded(
              child: TextField(
                controller: _taskCtrl,
                decoration: InputDecoration(
                  hintText: 'أضف مهمة مذاكرة جديدة...',
                  filled: true,
                  fillColor: Colors.white,
                  border: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: BorderSide.none),
                ),
              ),
            ),
            const SizedBox(width: 8),
            IconButton.filled(
              style: IconButton.styleFrom(backgroundColor: const Color(0xFF059669)),
              icon: const Icon(Icons.add),
              onPressed: () {
                if (_taskCtrl.text.trim().isNotEmpty) {
                  setState(() {
                    _tasks.add({'title': _taskCtrl.text.trim(), 'done': false});
                    _taskCtrl.clear();
                  });
                }
              },
            ),
          ],
        ),
        const SizedBox(height: 10),

        ..._tasks.map((task) => CheckboxListTile(
              value: task['done'],
              title: Text(
                task['title'],
                style: TextStyle(decoration: task['done'] ? TextDecoration.lineThrough : null),
              ),
              onChanged: (val) => setState(() => task['done'] = val),
            )),
      ],
    );
  }
}

ثالثاً: خطوات تصدير التطبيق لنظامي Android و Apple (iOS)
 * تفعيل الذكاء الاصطناعي الحقيقي:
   * احصل على مفتاح مجاني من موقع Google AI Studio وضعه مكان YOUR_GEMINI_API_KEY_HERE في الكود أعلاه.
 * لإخراج نسخة الأندرويد (APK / App Bundle):
   * نفّذ الأمر التالي في الطرفية (Terminal):
     flutter build apk --release

   * ستجد ملف التثبيت جاهزاً في المسار: build/app/outputs/flutter-apk/app-release.apk.
 * لإخراج نسخة الآيفون والآيباد (iOS / iPadOS):
   * على جهاز Mac مثبت عليه Xcode، نفّذ الأمر:
     flutter build ipa

   * أضف صلاحيات الوصول للملفات والصور في ملف ios/Runner/Info.plist:
     <key>NSPhotoLibraryUsageDescription</key>
<string>يحتاج تطبيق مِداد AI للوصول إلى الصور لرفع صفحات الكتب وشرحها</string>

